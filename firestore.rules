rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Baseline deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.userId == request.auth.uid &&
               data.roofArea is number && data.roofArea >= 0 &&
               data.tankCapacity is number && data.tankCapacity >= 0;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId;
    }

    // Entries Rules
    match /users/{userId}/entries/{entryId} {
      function isValidEntry(data) {
        return data.amountMm is number && data.amountMm >= 0 &&
               data.waterCollected is number && data.waterCollected >= 0 &&
               data.date is string; // Simplified date check
      }

      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidEntry(request.resource.data);
      allow update: if false; // Entries should be immutable for history integrity
      allow delete: if isOwner(userId);
    }
  }
}
